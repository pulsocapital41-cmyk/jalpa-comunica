---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { optimizeCloudinaryUrl, formatEditorialDate, getReadingTime } from '../utils/cloudinary';

const allNoticias = await getCollection('noticias');
const sortedNoticias = allNoticias.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Breaking news ticker item
const breakingArticle = sortedNoticias.slice(0, 6).find((n) => n.data.breaking) || sortedNoticias[0];

// Main Hero Article
const heroArticle = sortedNoticias.slice(0, 6).find((n) => n.data.featured) || sortedNoticias[0];

// Sub-hero pair (2 stories directly below the main hero story)
const remainingAfterHero = sortedNoticias.filter((n) => n.id !== heroArticle.id);
const heroSubArticles = remainingAfterHero.slice(0, 2);

// Secondary articles for the right sidebar ("Suceso al Momento")
const secondaryTopArticles = remainingAfterHero.slice(2, 6);

// Seguridad & Sucesos highlight strip
const topUsedIds = new Set([
  heroArticle.id,
  ...heroSubArticles.map((a) => a.id),
  ...secondaryTopArticles.map((a) => a.id),
]);

const seguridadArticles = sortedNoticias
  .filter((n) => !topUsedIds.has(n.id) && n.data.category === 'Seguridad')
  .slice(0, 3);

seguridadArticles.forEach((a) => topUsedIds.add(a.id));

const opinionArticles = sortedNoticias
  .filter((n) => !topUsedIds.has(n.id) && n.data.category === 'Opinión')
  .slice(0, 3);

opinionArticles.forEach((a) => topUsedIds.add(a.id));

const feedArticles = sortedNoticias
  .filter((n) => !topUsedIds.has(n.id))
  .slice(0, 18);

const heroImageOptimized = optimizeCloudinaryUrl(heroArticle.data.image, {
  width: 1200,
  height: 675,
  crop: 'fill',
});

const heroCategorySlug = heroArticle.data.category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/\s+/g, '-');
---

<BaseLayout currentCategory="Portada">
  <!-- Breaking News Bar ("Suceso al Momento") -->
  {breakingArticle && (
    <div class="breaking-bar">
      <div class="container-editorial breaking-inner">
        <span class="breaking-badge">
          <span class="live-pulse-dot" aria-hidden="true"></span>
          AL MOMENTO
        </span>
        <a href={`/noticias/${breakingArticle.id}`} class="breaking-link">
          {breakingArticle.data.title}
        </a>
      </div>
    </div>
  )}

  <div class="container-editorial main-portal-wrap">
    <!-- Above the Fold: Hero + Citizen Sidebar Column -->
    <section class="hero-editorial-grid" aria-label="Noticias Principales">
      <!-- Primary Featured Story (LCP Candidate) -->
      <article class="hero-main-story">
        <a href={`/noticias/${heroArticle.id}`} class="hero-media-link">
          <div class="hero-image-frame">
            <img
              src={heroImageOptimized}
              alt={heroArticle.data.title}
              width="1200"
              height="675"
              fetchpriority="high"
              class="hero-img"
            />
          </div>
          {heroArticle.data.imageCaption && (
            <span class="hero-caption">{heroArticle.data.imageCaption}</span>
          )}
        </a>

        <div class="hero-content">
          <a href={`/categoria/${heroCategorySlug}`} class="badge-category">
            {heroArticle.data.category}
          </a>

          <h1 class="headline-hero">
            <a href={`/noticias/${heroArticle.id}`} class="hero-title-link">
              {heroArticle.data.title}
            </a>
          </h1>

          {heroArticle.data.excerpt && (
            <p class="hero-excerpt">{heroArticle.data.excerpt}</p>
          )}

          <div class="hero-meta">
            <span class="meta-author">Por {heroArticle.data.author}</span>
            <span>·</span>
            <time datetime={heroArticle.data.pubDate.toISOString()}>
              {formatEditorialDate(heroArticle.data.pubDate)}
            </time>
            <span>·</span>
            <span>Lectura de {getReadingTime(heroArticle.body)} min</span>
          </div>
        </div>

        {heroSubArticles.length > 0 && (
          <div class="hero-sub-grid">
            {heroSubArticles.map((subArticle) => (
              <NewsCard article={subArticle} variant="default" />
            ))}
          </div>
        )}
      </article>

      <!-- Secondary Column ("Suceso hecho noticia · Al Momento") -->
      <aside class="hero-side-column" aria-label="Suceso al Momento">
        <div class="side-column-header">
          <span class="badge-category-solid">💬 Suceso hecho noticia · Al Momento</span>
        </div>
        <div class="side-stories-stack">
          {secondaryTopArticles.map((article, idx) => (
            <NewsCard article={article} variant={idx === 0 ? 'default' : 'compact'} />
          ))}
        </div>

      </aside>
    </section>

    <!-- Seguridad y Sucesos en Jalpa y la Chontalpa -->
    {seguridadArticles.length > 0 && (
      <section class="editorial-section deferred-editorial-section" aria-label="Seguridad y Sucesos">
        <div class="section-header-editorial">
          <h2 class="section-title-editorial">🚨 Seguridad, Operativos y Sucesos en Jalpa</h2>
          <a href="/categoria/seguridad" class="section-link-more">Ver Seguridad →</a>
        </div>
        <div class="three-col-grid">
          {seguridadArticles.map((article) => (
            <NewsCard article={article} variant="default" />
          ))}
        </div>
      </section>
    )}

    <!-- Below the Fold: Pulso de Jalpa de Méndez y Tabasco -->
    <section class="editorial-section deferred-editorial-section" aria-label="Actualidad en Jalpa de Méndez y Tabasco">
      <div class="section-header-editorial">
        <h2 class="section-title-editorial">📍 Metrópoli, Comunidad y Cobertura en Tabasco</h2>
        <a href="/categoria/metropoli" class="section-link-more">Ver todas en Metrópoli →</a>
      </div>

      <div class="three-col-grid">
        {feedArticles.map((article) => (
          <NewsCard article={article} variant="default" />
        ))}
      </div>
    </section>

    <!-- Identidad Chontal, Patrimonio y Opinión -->
    {opinionArticles.length > 0 && (
      <section class="editorial-section deferred-editorial-section" aria-label="Opinión e Identidad">
        <div class="section-header-editorial">
          <h2 class="section-title-editorial">🏺 Identidad de Jalpa, Patrimonio y Opinión</h2>
          <a href="/categoria/opinion" class="section-link-more">Ver Opinión →</a>
        </div>
        <div class="three-col-grid">
          {opinionArticles.map((article) => (
            <NewsCard article={article} variant="default" />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* Breaking News Ticker Bar */
  .breaking-bar {
    background-color: var(--color-qroo-cyan-light);
    border-bottom: 1px solid rgba(0, 117, 255, 0.22);
    padding: 0.55rem 0;
  }

  .breaking-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .breaking-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--color-qroo-navy);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.24rem 0.65rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .breaking-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-qroo-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breaking-link:hover {
    color: var(--color-qroo-cyan);
  }

  .main-portal-wrap {
    padding-top: 1.5rem;
  }

  /* Hero Editorial Grid */
  .hero-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-qroo-cyan);
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1024px) {
    .hero-editorial-grid {
      grid-template-columns: 1.75fr 1fr;
      gap: 2.5rem;
    }
  }

  .hero-main-story {
    display: flex;
    flex-direction: column;
  }

  .hero-media-link {
    display: block;
    margin-bottom: 1rem;
  }

  .hero-image-frame {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-qroo-mist);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hero-main-story:hover .hero-img {
    transform: scale(1.02);
  }

  .hero-caption {
    display: block;
    font-size: 0.75rem;
    color: var(--color-qroo-slate);
    margin-top: 0.4rem;
  }

  .hero-title-link:hover {
    color: var(--color-qroo-cyan);
  }

  .hero-excerpt {
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--color-qroo-muted);
    margin: 0 0 1rem 0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--color-qroo-slate);
    border-top: 1px solid var(--color-qroo-border);
    padding-top: 0.75rem;
  }

  .meta-author {
    font-weight: 700;
    color: var(--color-qroo-navy);
  }

  .hero-sub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-qroo-border);
  }

  @media (min-width: 640px) {
    .hero-sub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Side Column */
  .hero-side-column {
    border-top: 1px solid var(--color-qroo-border);
    padding-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .hero-side-column {
      border-top: none;
      padding-top: 0;
      border-left: 1px solid var(--color-qroo-border);
      padding-left: 2rem;
    }
  }

  .side-column-header {
    margin-bottom: 1.25rem;
  }

  .side-stories-stack {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  /* Citizen Alert Box */
  .citizen-alert-card {
    margin-top: 1.75rem;
    padding: 1.15rem 1.25rem;
    background: linear-gradient(135deg, #ebf5ff 0%, #f4f8fd 100%);
    border: 1px solid rgba(0, 117, 255, 0.3);
    border-left: 4px solid var(--color-qroo-cyan);
    border-radius: var(--radius-sm);
  }

  .citizen-alert-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--color-qroo-navy);
    margin-bottom: 0.4rem;
  }

  .citizen-alert-card p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-qroo-slate);
    margin: 0 0 0.85rem 0;
  }

  .citizen-btn {
    display: inline-block;
    background-color: var(--color-qroo-cyan);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    transition: background-color 0.15s ease;
  }

  .citizen-btn:hover {
    background-color: var(--color-qroo-navy);
    color: #ffffff;
  }

  /* Three Column Feed Grid */
  .editorial-section {
    margin-bottom: 3rem;
  }

  .three-col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .three-col-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .three-col-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
